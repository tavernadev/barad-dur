# Barad-dûr configuration. Copy to .env (gitignored) and adjust; real environment variables win over .env.
# Nothing here is a secret: keep tokens and passwords out of this file and out of the repo.

# Name shown in the browser tab.
APP_NAME=Barad-dûr

# Web server. Keep HOST on loopback: the page can open a shell through the terminal.
HOST=127.0.0.1
PORT=8080

# Browser terminal (ttyd). Interface defaults to lo0 on macOS and lo elsewhere.
TTYD_PORT=7681
# TTYD_INTERFACE=lo0
# Signal sent to a session when its browser tab closes, so closing a tab ends the session (opening the card resumes it).
# ttyd's own default, SIGHUP, did not end Claude Code, which left a background process per closed tab.
TTYD_CLOSE_SIGNAL=SIGKILL
# Terminal background color (any CSS hex color). Default is pure black.
# TTYD_BACKGROUND=#000000

# Where private data lives: your cards (inbox/ and topics/), their tasks, Claude session ids and the card counter.
# Never committed.
# A folder inside the repo (relative paths are resolved from the repo folder; ./data is already gitignored):
DATA_DIR=data
# ...or a full path anywhere on disk (~ is expanded), for example:
# DATA_DIR=/home/you/barad-dur-data
# DATA_DIR=~/barad-dur-data
# Leave it unset and ./data is used. An older cards/ layout is converted automatically at startup.

# Base URL for ticket links; the ticket key is appended. Leave empty and keys are shown without a link.
LINEAR_BASE_URL=https://linear.app/your-workspace/issue/

# Claude Code executable used by the terminal sessions.
CLAUDE_BIN=claude

# GitHub CLI used by card templates to read a pull request's title, size and ticket key (read-only; it never writes to GitHub).
# Without it, or when it is not signed in, the card is still created with the link and the blanks left visible.
GH_BIN=gh

# VS Code command used by the header's Settings > Open in VS Code (runs it on this project's folder).
# On macOS install it from VS Code: Command Palette > "Shell Command: Install 'code' command in PATH".
CODE_BIN=code

# Open the browser on `npm start` (set to 0 to skip).
OPEN_BROWSER=1
